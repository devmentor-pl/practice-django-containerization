# Django Security
# Klucz bezpieczeństwa Django - ZMIEŃ NA UNIKALNĄ WARTOŚĆ W PRODUKCJI!
SECRET_KEY=django-insecure-your-secret-key-here-change-this-in-production

# Django Debug Mode
# 1 = włączony (development), 0 = wyłączony (production)
DEBUG=1

# Dozwolone hosty
# Oddziel wartości przecinkami - dodaj swoje domeny w produkcji
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database Configuration
# Nazwa bazy danych
POSTGRES_DB=project-db

# Użytkownik bazy danych
POSTGRES_USER=your-username

# Hasło bazy danych - ZMIEŃ NA BEZPIECZNE HASŁO!
POSTGRES_PASSWORD=your-db-password

# Host bazy danych (w Docker Compose to nazwa usługi: 'db')
POSTGRES_HOST=db
